# Copy to .env for local development. Never commit .env.
ENV=development
# Supabase Postgres connection string (Session or Transaction pooler URL).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Supabase project URL, used to fetch the JWKS for asymmetric JWTs.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Legacy HS256 JWT secret (Supabase dashboard > Project Settings > API). Leave blank if the project uses asymmetric keys.
SUPABASE_JWT_SECRET=
# Emails that receive the admin role on first login. Comma-separated.
BOOTSTRAP_ADMIN_EMAILS=
# true: admin and staff tokens must carry aal2 (authenticator code entered). Only after every staff account has enrolled a TOTP factor.
REQUIRE_STAFF_MFA=false
